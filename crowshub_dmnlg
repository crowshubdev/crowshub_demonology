end

-- ═══ СКАНЕР ЖУРНАЛА (pills) ═══
local function scanGui(root)
    -- собираем тексты всех TextLabel/TextBox в PlayerGui
    local texts = {}
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextBox") then
            local tx = d.Text
            if tx and #tx > 0 and #tx < 400 then
                texts[#texts + 1] = tx
            end
        end
    end
    return texts
end

local function scanPills()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end
    local texts = scanGui(pg)
    local ev, cf = {}, {}
    local solver = {}
    for _, tx in ipairs(texts) do
        local low = tx:lower()
        -- улики: "[EMF] ...", "EMF: ..." и т.п. (короткие подписи-пилюли)
        for _, e in ipairs(EVIDENCE_PATTERNS) do
            if #tx <= 200 and tx:match(e.pat) then
                ev[e.key] = true
                if low:find("confirm") then cf[e.key] = true end
            end
        end
        -- солвер: копируем вывод журнала целиком
        if tx:find("^Confirmed: ") or tx:find("^Possible: ")
            or tx:find("^Close %(1 evidence may be fake%): ")
            or tx:find("^No ghost matches") then
            solver[#solver + 1] = tx
        end
        -- spirit box: возраст/пол/комнаты/температура
        local sb = tx:match("^%s*%[?SPIRIT BOX%]?%s*[:%-]%s*(.+)$")
        local src = sb or tx
        local age = src:match("[Aa]ge%s*[:%-]%s*(%d+)")
        if age then DATA.age = age end
        local gen = src:match("[Gg]ender%s*[:%-]%s*([%w%s]+)")
        if gen then DATA.gender = gen:match("^%s*(.-)%s*$") end
        local room = src:match("Current Room%s*[:%-]%s*([^,]+)")
        if room then DATA.room = room:match("^%s*(.-)%s*$") end
        local fav = src:match("Favorite Room%s*[:%-]%s*(.+)")
        if fav then DATA.favRoom = fav:match("^%s*(.-)%s*$") end
        local temp = src:match("Temperature%s*[:%-]%s*(-?%d+%.?%d*)")
        if temp then DATA.temperature = tonumber(temp) end
        local diff = src:match("Difficulty%s*[:%-]%s*(.+)")
        if diff then DATA.difficulty = diff:match("^%s*(.-)%s*$") end
        if low:find("hunting") then DATA.hunting = "Hunting" end
    end
    DATA.evidence = ev
    DATA.confirmed = cf
    DATA.solverLines = solver
    DATA.lastUpdate = os.clock()
end

-- ═══ ESP ═══
local espObjects = {} -- [model] = {billboard, highlight}
local function espCleanup()
    for obj, set in pairs(espObjects) do
        pcall(function()
            if set.billboard then set.billboard:Destroy() end
            if set.highlight then set.highlight:Destroy() end
        end)
        espObjects[obj] = nil
    end
end

local function espAttach(obj, text, color, showDist)
    if not obj or not obj.Parent then return end
    local set = espObjects[obj]
    if not set then
        set = {}
        pcall(function()
            local hl = Instance.new("Highlight")
            hl.Name = "DHL_ESP"
            hl.Adornee = obj
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = 0.75
            hl.OutlineTransparency = 0.1
            hl.FillColor = color
            hl.OutlineColor = color
            hl.Parent = obj:IsA("BasePart") and obj or (obj:FindFirstChildWhichIsA("BasePart", true) or obj)
            set.highlight = hl
        end)
        pcall(function()
            local base = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
            if not base then return end
            local bb = Instance.new("BillboardGui")
            bb.Name = "DHL_Tag"
            bb.Adornee = base
            bb.Size = UDim2.fromOffset(200, 46)
            bb.StudsOffset = Vector3.new(0, 2.8, 0)
            bb.AlwaysOnTop = true
            bb.MaxDistance = 500
            local tl = Instance.new("TextLabel")
            tl.Name = "T"
            tl.Size = UDim2.new(1, 0, 1, 0)
            tl.BackgroundTransparency = 1
            tl.Font = Enum.Font.GothamBold
            tl.TextSize = 13
            tl.TextColor3 = color
            tl.TextStrokeTransparency = 0
            tl.TextStrokeColor3 = Color3.new(0, 0, 0)
            tl.TextWrapped = true
            tl.Text = text
            tl.Parent = bb
            bb.Parent = base
            set.billboard = bb
        end)
        espObjects[obj] = set
    end
    -- обновляем подпись (дистанция)
    local hrp = getHRP(getChar(LocalPlayer))
    if set.billboard and hrp then
        local base = set.billboard.Adornee
        if base then
            local d = (base.Position - hrp.Position).Magnitude
            local tl = set.billboard:FindFirstChild("T")
            if tl then
                tl.Text = showDist and (text .. "\n" .. string.format("%.0f studs", d)) or text
            end
        end
    end
end

local function findGhostModel()
    -- призрак: Model в workspace, имя = имя призрака (или Entity/Doppelganger)
    for _, d in ipairs(workspace:GetChildren()) do
        if d:IsA("Model") then
            local nm = d.Name:lower()
            if GHOST_LOWER[nm] or nm == "entity" or nm:find("doppelganger") then
                return d
            end
        end
    end
    -- запасной вариант: в под-папках
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Model") then
            local nm = d.Name:lower()
            if GHOST_LOWER[nm] or nm == "entity" then
                return d
            end
        end
    end
    return nil
end

local function espLoop()
    pcall(function()
        -- чистим мёртвые
        for obj in pairs(espObjects) do
            if not obj.Parent then espObjects[obj] = nil end
        end
        local hrp = getHRP(getChar(LocalPlayer))

        -- Ghost ESP
        if CFG.GhostESP then
            local g = findGhostModel()
            if g then espAttach(g, "👻 " .. g.Name, Color3.fromRGB(255, 64, 64), true) end
        end

        -- Ghost Orb
        if CFG.OrbESP then
            local orb = workspace:FindFirstChild("GhostOrb") or workspace:FindFirstChild("GhostOrb", true)
            if orb then espAttach(orb, "🔮 Ghost Orb", Color3.fromRGB(170, 120, 255), true) end
        end

        -- Handprints / ScratchText
        if CFG.HandprintsESP then
            local hp = workspace:FindFirstChild("Handprints") or workspace:FindFirstChild("Handprints", true)
            if hp then espAttach(hp, "🖐 Handprints", Color3.fromRGB(255, 170, 80), true) end
        end
        if CFG.ScratchESP then
            local sc = workspace:FindFirstChild("ScratchText") or workspace:FindFirstChild("ScratchText", true)
            if sc then espAttach(sc, "🐾 Scratch", Color3.fromRGB(120, 255, 160), true) end
        end

        -- Item ESP: все объекты с тегом interactables
        if CFG.ItemESP then
            local okT, tagged = pcall(function() return CollectionService:GetTagged("interactables") end)
            if okT and tagged then
                for _, it in ipairs(tagged) do
                    if it and it.Parent then
                        local nm = it.Name
                        espAttach(it, "📦 " .. nm, Color3.fromRGB(90, 230, 130), true)
                    end
                end
            end
        end
    end)
end

-- ═══ FULLBRIGHT ═══
local lightBackup = nil
local function fullbrightApply()
    pcall(function()
        if (CFG.Fullbright or CFG.SunFullbright) and not lightBackup then
            lightBackup = {
                Ambient = Lighting.Ambient,
                OutdoorAmbient = Lighting.OutdoorAmbient,
                Brightness = Lighting.Brightness,
                FogEnd = Lighting.FogEnd,
                GlobalShadows = Lighting.GlobalShadows,
            }
        end
        if CFG.Fullbright then
            Lighting.Ambient = Color3.fromRGB(190, 190, 190)
            Lighting.OutdoorAmbient = Color3.fromRGB(190, 190, 190)
            Lighting.Brightness = 2
            Lighting.FogEnd = 1e5
            Lighting.GlobalShadows = false
        elseif CFG.SunFullbright then
            -- мягкий вариант: только яркость солнца, тени остаются
            Lighting.Brightness = 3
            Lighting.FogEnd = 1e5
            Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 150)
        elseif lightBackup then
            Lighting.Ambient = lightBackup.Ambient
            Lighting.OutdoorAmbient = lightBackup.OutdoorAmbient
            Lighting.Brightness = lightBackup.Brightness
            Lighting.FogEnd = lightBackup.FogEnd
            Lighting.GlobalShadows = lightBackup.GlobalShadows
            lightBackup = nil
        end
    end)
end

