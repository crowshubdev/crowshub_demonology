-- ═══════════════════════════════════════════════════════════════
--  UI B: РЕЗЕРВНЫЙ ВСТРОЕННЫЙ GUI (работает БЕЗ Wind UI/интернета)
--  Тоже с прямоугольной кнопкой «CROWS HUB» и «Проверить улики».
-- ═══════════════════════════════════════════════════════════════
local function buildFallbackGui()
    local parent = nil
    pcall(function()
        if gethui then parent = gethui() end
    end)
    if not parent then
        pcall(function() parent = game:GetService("CoreGui") end)
    end
    if not parent then
        pcall(function()
            parent = LocalPlayer:FindFirstChild("PlayerGui") or game:GetService("Players").LocalPlayer.PlayerGui
        end)
    end
    if not parent then return false end

    local gui = Instance.new("ScreenGui")
    gui.Name = "DHL_Fallback"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 1000
    gui.Parent = parent

    -- прямоугольная кнопка открытия (без UICorner)
    local openBtn = Instance.new("TextButton")
    openBtn.Name = "OpenButton"
    openBtn.Size = UDim2.fromOffset(150, 42)
    openBtn.Position = UDim2.new(0, 12, 1, -54)
    openBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
    openBtn.BorderSizePixel = 0
    openBtn.Font = Enum.Font.GothamBold
    openBtn.TextSize = 15
    openBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    openBtn.Text = "CROWS HUB"
    openBtn.AutoButtonColor = true
    openBtn.Parent = gui
    local openStroke = Instance.new("UIStroke")
    openStroke.Color = Color3.fromRGB(255, 70, 70)
    openStroke.Thickness = 2
    openStroke.Parent = openBtn

    -- окно
    local win = Instance.new("Frame")
    win.Name = "Window"
    win.Size = UDim2.fromOffset(310, 360)
    win.Position = UDim2.new(0.5, -155, 0.5, -180)
    win.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
    win.BorderSizePixel = 0
    win.Active = true
    win.Visible = true
    win.Parent = gui
    local winStroke = Instance.new("UIStroke")
    winStroke.Color = Color3.fromRGB(70, 70, 90)
    winStroke.Thickness = 1
    winStroke.Parent = win

    -- тайтлбар + крестик + перетаскивание
    local title = Instance.new("TextButton")
    title.Name = "TitleBar"
    title.Size = UDim2.new(1, 0, 0, 30)
    title.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    title.BorderSizePixel = 0
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14
    title.TextColor3 = Color3.fromRGB(255, 90, 90)
    title.Text = "  CROWS HUB • Demonology"
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = win
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.fromOffset(30, 30)
    closeBtn.Position = UDim2.new(1, -30, 0, 0)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 14
    closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeBtn.Text = "X"
    closeBtn.Parent = title

    local dragging, dragStart, startPos = false, nil, nil
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = win.Position
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            win.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- скролл-контент
    local content = Instance.new("ScrollingFrame")
    content.Name = "Content"
    content.Size = UDim2.new(1, -8, 1, -38)
    content.Position = UDim2.fromOffset(4, 32)
    content.BackgroundTransparency = 1
    content.BorderSizePixel = 0
    content.ScrollingDirection = Enum.ScrollingDirection.Y
    content.AutomaticCanvasSize = Enum.AutomaticSize.Y
    content.CanvasSize = UDim2.new(0, 0, 0, 0)
    content.ScrollBarThickness = 4
    content.Parent = win
    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 4)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Parent = content

    local order = 0
    local function nextOrder() order = order + 1 return order end

    local function mkToggle(text, get, set)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -8, 0, 30)
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 13
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.LayoutOrder = nextOrder()
        btn.Parent = content
        local function refresh()
            btn.Text = (get() and "🟢 " or "⚫ ") .. text
            btn.TextColor3 = get() and Color3.fromRGB(140, 255, 160) or Color3.fromRGB(200, 200, 210)
        end
        btn.MouseButton1Click:Connect(function()
            set(not get())
            refresh()
        end)
        refresh()
        return btn
    end

    local function mkValueRow(text, get, set, step, min, max)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -8, 0, 30)
        row.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
        row.BorderSizePixel = 0
        row.LayoutOrder = nextOrder()
        row.Parent = content
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -80, 1, 0)
        lbl.Position = UDim2.fromOffset(8, 0)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 13
        lbl.TextColor3 = Color3.fromRGB(200, 200, 210)
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = row
        local function refresh()
            lbl.Text = text .. ": " .. tostring(get())
        end
        local function mkBtn(sign, dx)
            local b = Instance.new("TextButton")
            b.Size = UDim2.fromOffset(30, 22)
            b.Position = UDim2.new(1, dx, 0.5, -11)
            b.BackgroundColor3 = Color3.fromRGB(50, 50, 62)
            b.BorderSizePixel = 0
            b.Font = Enum.Font.GothamBold
            b.TextSize = 14
            b.TextColor3 = Color3.fromRGB(255, 255, 255)
            b.Text = sign
            b.Parent = row
            b.MouseButton1Click:Connect(function()
                local delta = (sign == "-") and -step or step
                set(math.clamp(get() + delta, min, max))
                refresh()
            end)
        end
        mkBtn("-", -70)
        mkBtn("+", -36)
        refresh()
        return row
    end

    -- тогглы
    mkToggle("Сканировать журнал (авто)", function() return CFG.EvidenceWatch end, function(v) ACTIONS.EvidenceWatch(v) end)
    mkToggle("Показывать панель", function() return CFG.PanelVisible end, function(v) ACTIONS.PanelVisible(v) end)
    mkToggle("👻 Ghost ESP", function() return CFG.GhostESP end, function(v) ACTIONS.GhostESP(v) end)
    mkToggle("🔮 Ghost Orb ESP", function() return CFG.OrbESP end, function(v) ACTIONS.OrbESP(v) end)
    mkToggle("🖐 Handprints ESP", function() return CFG.HandprintsESP end, function(v) ACTIONS.HandprintsESP(v) end)
    mkToggle("🐾 Inscription ESP", function() return CFG.ScratchESP end, function(v) ACTIONS.ScratchESP(v) end)
    mkToggle("📦 Item ESP", function() return CFG.ItemESP end, function(v) ACTIONS.ItemESP(v) end)
    mkToggle("Ghost Info (Spirit Box)", function() return CFG.GhostInfo end, function(v) ACTIONS.GhostInfo(v) end)
    mkToggle("🩸 Анти-хант (ТП на базу)", function() return CFG.AntiHunt end, function(v) ACTIONS.AntiHunt(v) end)
    mkToggle("♾ Инф стамина", function() return CFG.InfStamina end, function(v) ACTIONS.InfStamina(v) end)
    mkToggle("Fullbright", function() return CFG.Fullbright end, function(v) ACTIONS.Fullbright(v) end)
    mkToggle("Sun Bright (мягкий)", function() return CFG.SunFullbright end, function(v) ACTIONS.SunFullbright(v) end)
    mkValueRow("Скорость", function() return CFG.Speed end, function(n) ACTIONS.Speed(n) end, 2, 8, 100)
    mkValueRow("FOV", function() return CFG.FOV end, function(n) ACTIONS.FOV(n) end, 10, 30, 250)

    -- кнопка ПРОВЕРИТЬ УЛИКИ + отчёт внутри меню
    local checkBtn = Instance.new("TextButton")
    checkBtn.Size = UDim2.new(1, -8, 0, 34)
    checkBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 40)
    checkBtn.BorderSizePixel = 0
    checkBtn.Font = Enum.Font.GothamBold
    checkBtn.TextSize = 14
    checkBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    checkBtn.Text = "🔍 ПРОВЕРИТЬ УЛИКИ"
    checkBtn.LayoutOrder = nextOrder()
    checkBtn.Parent = content
    local reportLbl = Instance.new("TextLabel")
    reportLbl.Size = UDim2.new(1, -8, 0, 170)
    reportLbl.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
    reportLbl.BorderSizePixel = 0
    reportLbl.Font = Enum.Font.Code
    reportLbl.TextSize = 11
    reportLbl.TextColor3 = Color3.fromRGB(230, 232, 240)
    reportLbl.TextXAlignment = Enum.TextXAlignment.Left
    reportLbl.TextYAlignment = Enum.TextYAlignment.Top
    reportLbl.TextWrapped = true
    reportLbl.Text = "нажми «ПРОВЕРИТЬ УЛИКИ» —\nтут будут улики, запись журнала\nи решение (призрак)"
    reportLbl.LayoutOrder = nextOrder()
    reportLbl.Parent = content
    checkBtn.MouseButton1Click:Connect(function()
        local ok, rep = pcall(buildReport)
        if ok then reportLbl.Text = rep end
    end)

    local resetBtn = Instance.new("TextButton")
    resetBtn.Size = UDim2.new(1, -8, 0, 28)
    resetBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    resetBtn.BorderSizePixel = 0
    resetBtn.Font = Enum.Font.Gotham
    resetBtn.TextSize = 12
    resetBtn.TextColor3 = Color3.fromRGB(220, 220, 230)
    resetBtn.Text = "↩ Сброс данных (новый раунд)"
    resetBtn.LayoutOrder = nextOrder()
    resetBtn.Parent = content
    resetBtn.MouseButton1Click:Connect(function()
        ACTIONS.ResetData()
        reportLbl.Text = "данные сброшены"
    end)

    -- открытие/закрытие
    openBtn.MouseButton1Click:Connect(function()
        win.Visible = not win.Visible
    end)
    closeBtn.MouseButton1Click:Connect(function()
        win.Visible = false
    end)
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.RightShift then
            win.Visible = not win.Visible
        end
    end)

    print("[DHL] резервный GUI готов — кнопка CROWS HUB на экране")
    return true
end

