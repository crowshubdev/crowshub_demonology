local function evText()
    local lines = {}
    local found = 0
    for _, e in ipairs(EVIDENCE_DEFS) do
        if DATA.evidence[e.key] then
            found = found + 1
            lines[#lines + 1] = (DATA.confirmed[e.key] and "✔ " or "• ") .. e.label
        end
    end
    if found == 0 then lines[#lines + 1] = "улик пока нет" end
    lines[#lines + 1] = ""
    for _, s in ipairs(DATA.solverLines) do
        lines[#lines + 1] = s
    end
    return table.concat(lines, "\n")
end

local function giText()
    local t = DATA.temperature
    if worldScan.minTemp ~= nil and (t == nil or worldScan.minTemp < t) then
        t = worldScan.minTemp
        DATA.temperature = t
        DATA.room = worldScan.minTempRoom
    end
    if worldScan.hunting ~= "?" then DATA.hunting = worldScan.hunting end
    local lines = {
        "Возраст: " .. DATA.age,
        "Пол: " .. DATA.gender,
        "Комната (холодная): " .. DATA.room,
        "Любимая комната: " .. DATA.favRoom,
        "Температура: " .. (t and string.format("%.1f", t) or "n/a"),
        "Сложность: " .. DATA.difficulty,
        "Состояние: " .. DATA.hunting,
    }
    if #worldScan.sbAnswer:gsub("%s+", "") >= 3 then
        lines[#lines + 1] = "Spirit Box: " .. worldScan.sbAnswer
    end
    if worldScan.emf > 0 then
        lines[#lines + 1] = "EMF сейчас: " .. worldScan.emf
    end
    if worldScan.laserPlaced then
        lines[#lines + 1] = "Лазер: поставлен"
    end
    if worldScan.itemsCount > 0 then
        lines[#lines + 1] = "Предметов: " .. worldScan.itemsCount
    end
    return table.concat(lines, "\n")
end

