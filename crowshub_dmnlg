local panelRefreshT = 0
task.spawn(function()
    while true do
        if not getgenv().DHL_RUN then break end
        local ok, err = pcall(function()
            -- сканер журнала
            if CFG.EvidenceWatch then
                scanPills()
            end
            -- ESP
            if CFG.GhostESP or CFG.OrbESP or CFG.HandprintsESP or CFG.ScratchESP or CFG.ItemESP then
                espLoop()
            else
                espCleanup()
            end
            -- стамина
            if CFG.InfStamina then
                staminaTick()
            end
            -- панель раз в 0.4с
            if os.clock() - panelRefreshT > 0.4 then
                panelRefreshT = os.clock()
                panelSet(evFrame, CFG.EvidenceWatch and evText() or "сканер выключен")
                panelSet(ghostFrame, CFG.GhostInfo and giText() or "сканер выключен")
                panelVisible(CFG.PanelVisible)
            end
        end)
        if not ok then warn("[DHL] loop error: " .. tostring(err)) end
        task.wait(0.2)
    end
end)

