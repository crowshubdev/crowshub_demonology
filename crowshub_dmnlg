-- ═══ ИНФ СТАМИНА ═══
local staminaMaxSeen = 0
local function staminaTick()
    pcall(function()
        local c = getChar(LocalPlayer)
        local holders = { c, LocalPlayer }
        for _, holder in ipairs(holders) do
            if holder then
                -- Value-объекты (Stamina/Energy)
                for _, v in ipairs(holder:GetChildren()) do
                    if (v:IsA("NumberValue") or v:IsA("IntValue"))
                        and v.Name:lower():find("stamina") then
                        if v.Value > staminaMaxSeen then staminaMaxSeen = v.Value end
                        if staminaMaxSeen > 0 then v.Value = staminaMaxSeen end
                    end
                end
                -- атрибуты
                local maxAttr = holder:GetAttribute("MaxStamina") or holder:GetAttribute("maxStamina")
                if maxAttr and holder:GetAttribute("Stamina") ~= nil then
                    if maxAttr > staminaMaxSeen then staminaMaxSeen = maxAttr end
                    holder:SetAttribute("Stamina", staminaMaxSeen)
                end
            end
        end
    end)
end

