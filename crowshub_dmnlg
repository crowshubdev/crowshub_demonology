local espObjects = {} -- [model] = {billboard, highlight}
local function espCleanup()
    for obj, set in pairs(espObjects) do
        pcall(function()
            if set.billboard then set.billboard:Destroy() end
            if set.highlight then set.highlight:Destroy() end
        end)
        espObjects[obj] = nil
    end
end

local function espAttach(obj, text, color, showDist)
    if not obj or not obj.Parent then return end
    local set = espObjects[obj]
    if not set then
        set = {}
        pcall(function()
            local hl = Instance.new("Highlight")
            hl.Name = "DHL_ESP"
            hl.Adornee = obj
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = 0.75
            hl.OutlineTransparency = 0.1
            hl.FillColor = color
            hl.OutlineColor = color
            hl.Parent = obj:IsA("BasePart") and obj or (obj:FindFirstChildWhichIsA("BasePart", true) or obj)
            set.highlight = hl
        end)
        pcall(function()
            local base = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
            if not base then return end
            local bb = Instance.new("BillboardGui")
            bb.Name = "DHL_Tag"
            bb.Adornee = base
            bb.Size = UDim2.fromOffset(200, 46)
            bb.StudsOffset = Vector3.new(0, 2.8, 0)
            bb.AlwaysOnTop = true
            bb.MaxDistance = 500
            local tl = Instance.new("TextLabel")
            tl.Name = "T"
            tl.Size = UDim2.new(1, 0, 1, 0)
            tl.BackgroundTransparency = 1
            tl.Font = Enum.Font.GothamBold
            tl.TextSize = 13
            tl.TextColor3 = color
            tl.TextStrokeTransparency = 0
            tl.TextStrokeColor3 = Color3.new(0, 0, 0)
            tl.TextWrapped = true
            tl.Text = text
            tl.Parent = bb
            bb.Parent = base
            set.billboard = bb
        end)
        espObjects[obj] = set
    end
    local hrp = getHRP(getChar(LocalPlayer))
    if set.billboard and hrp then
        local base = set.billboard.Adornee
        if base then
            local d = (base.Position - hrp.Position).Magnitude
            local tl = set.billboard:FindFirstChild("T")
            if tl then
                tl.Text = showDist and (text .. "\n" .. string.format("%.0f studs", d)) or text
            end
        end
    end
end

local function findGhostModel()
    -- в Demonology модель призрака называется просто Ghost
    local g = workspace:FindFirstChild("Ghost")
    if g and g.Parent then return g end
    -- запасной поиск по именам из матрицы (на случай обновления игры)
    for _, d in ipairs(workspace:GetChildren()) do
        if d:IsA("Model") then
            local nm = d.Name:lower()
            if GHOST_LOWER[nm] or nm == "entity" or nm:find("doppelganger") then
                return d
            end
        end
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Model") then
            local nm = d.Name:lower()
            if GHOST_LOWER[nm] or nm == "entity" then
                return d
            end
        end
    end
    return nil
end

local function espLoop()
    local okE, errE = pcall(function()
        for obj in pairs(espObjects) do
            if not obj.Parent then espObjects[obj] = nil end
        end
        local hrp = getHRP(getChar(LocalPlayer))
        if hrp == nil then return end

        if CFG.GhostESP then
            local g = findGhostModel()
            if g then
                espAttach(g, "👻 Ghost" .. (g:GetAttribute("Hunting") == true and " — ОХОТА!" or ""), Color3.fromRGB(255, 64, 64), true)
            end
        end
        if CFG.OrbESP then
            -- часть GhostOrb где-то в комнате призрака (не папка!)
            local orb = worldScan.orb
            if orb and orb.Parent then
                espAttach(orb, "🔮 Ghost Orb", Color3.fromRGB(170, 120, 255), true)
            end
        end
        if CFG.HandprintsESP then
            -- каждая часть из папки Handprints отдельно (Highlight на
            -- папку не рендерится)
            local hp = workspace:FindFirstChild("Handprints")
            if hp then
                for _, part in ipairs(hp:GetChildren()) do
                    if part and part.Parent then
                        espAttach(part, "🖐 Handprint", Color3.fromRGB(255, 170, 80), true)
                    end
                end
            end
            -- запасной вариант: принты разбросаны по workspace
            if worldScan.prints then
                for _, d in ipairs(workspace:GetDescendants()) do
                    if d:IsA("BasePart") and (d.Name == "Handprint1" or d.Name == "Handprint2"
                        or d.Name == "Footprint" or d.Name == "Footprint1")
                        and d.Parent and d.Parent ~= hp then
                        espAttach(d, "🖐 Prints", Color3.fromRGB(255, 170, 80), true)
                    end
                end
            end
        end
        if CFG.ScratchESP then
            -- Inscription: надписи/царапины призрака (часть с именем Inscription*)
            local sc = worldScan.insc
            if sc and sc.Parent then
                espAttach(sc, "🐾 Inscription", Color3.fromRGB(120, 255, 160), true)
            end
        end
        if CFG.ItemESP then
            -- предметы лежат в workspace.Items и workspace.Interactables
            local items = workspace:FindFirstChild("Items")
            if items then
                for _, it in ipairs(items:GetChildren()) do
                    if it and it.Parent then
                        local dn = it:GetAttribute("DisplayName")
                        espAttach(it, "📦 " .. (dn or it.Name), Color3.fromRGB(90, 230, 130), true)
                    end
                end
            end
            local inter = workspace:FindFirstChild("Interactables")
            if inter then
                for _, it in ipairs(inter:GetChildren()) do
                    if it and it.Parent then
                        espAttach(it, "✳ " .. it.Name, Color3.fromRGB(230, 210, 90), true)
                    end
                end
            end
        end
    end)
    if not okE then warn("[DHL] espLoop error: " .. tostring(errE)) end
end

