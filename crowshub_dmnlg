local dummyEl
dummyEl = setmetatable({}, {
    __index = function() return function() return dummyEl end end,
    __call = function() return dummyEl end,
})

local function safe(fn, what)
    local ok, res = pcall(fn)
    if not ok or res == nil then
        warn("[DHL] " .. what .. ": " .. tostring(res))
        return dummyEl
    end
    return res
end

