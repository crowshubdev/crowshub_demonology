TabChar:Section({ Title = "Стамина / Скорость / FOV" })
TabChar:Toggle({
    Title = "♾ Бесконечная стамина",
    Desc = "Держит стамину на максимуме (значения Stamina в персонаже и атрибутах)",
    Value = false,
    Callback = function(v) CFG.InfStamina = v end,
})
TabChar:Slider({
    Title = "Скорость",
    Desc = "WalkSpeed персонажа",
    Step = 1,
    Value = { Min = 8, Max = 100, Default = 16 },
    Callback = function(v)
        CFG.Speed = v
        speedApply()
    end,
})
TabChar:Input({
    Title = "Скорость (вписать)",
    Placeholder = "число 8-100",
    Callback = function(txt)
        local n = tonumber((tostring(txt or ""):gsub("[^%d]", "")))
        if n then
            n = math.clamp(n, 8, 100)
            CFG.Speed = n
            speedApply()
            Notify("Персонаж", "Скорость: " .. n, 2)
        end
    end,
})
TabChar:Slider({
    Title = "FOV",
    Desc = "Поле зрения камеры",
    Step = 1,
    Value = { Min = 30, Max = 250, Default = 70 },
    Callback = function(v)
        CFG.FOV = v
        fovApply()
    end,
})
TabChar:Input({
    Title = "FOV (вписать)",
    Placeholder = "число 30-250",
    Callback = function(txt)
        local n = tonumber((tostring(txt or ""):gsub("[^%d]", "")))
        if n then
            n = math.clamp(n, 30, 250)
            CFG.FOV = n
            fovApply()
            Notify("Персонаж", "FOV: " .. n, 2)
        end
    end,
})
TabChar:Button({
    Title = "↩ Сброс (скорость 16, FOV 70)",
    Callback = function()
        CFG.Speed = 16
        CFG.FOV = 70
        speedApply()
        fovApply()
        Notify("Персонаж", "Скорость 16, FOV 70", 2)
    end,
})

