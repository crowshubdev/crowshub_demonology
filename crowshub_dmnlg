-- ═══ СОЛВЕР (порт логики DemonologyX) ═══
-- Возвращает строки: точный призрак / возможные / близкие (1 улика
-- может быть фейк) / предупреждение про фейк-орб на 4 уликах.
local function solverLines()
    local E = {}
    local n = 0
    for k in pairs(DATA.evidence) do
        E[k] = true
        n = n + 1
    end
    if n == 0 then return { "улик пока нет — открой журнал в игре" } end

    local lines = {}
    local Ematch = E
    -- 4 улики → Ghost Orb фейк (только Doppelgangers умеют подделывать орб)
    if n >= 4 and E.Orb then
        lines[#lines + 1] = "4 улики → Ghost Orb ФЕЙК (только Doppelgangers подделывают орб)"
        Ematch = {}
        for k in pairs(E) do
            if k ~= "Orb" then Ematch[k] = true end
        end
    end

    local exact, close = {}, {}
    for name, set in pairs(GHOST_MATRIX) do
        local hit, miss = 0, 0
        for _, k in ipairs(set) do
            if Ematch[k] then hit = hit + 1 else miss = miss + 1 end
        end
        if miss == 0 then
            exact[#exact + 1] = name
        elseif hit == 2 and miss == 1 then
            close[#close + 1] = name
        end
    end
    table.sort(exact)
    table.sort(close)

    if #exact == 1 then
        lines[#lines + 1] = "Точный призрак: " .. exact[1]
    elseif #exact > 1 then
        lines[#lines + 1] = "Возможные (" .. #exact .. "): " .. table.concat(exact, ", ")
    end
    if #close > 0 then
        lines[#lines + 1] = "Близкие (1 улика может быть фейк): " .. table.concat(close, ", ")
    end
    if #exact == 0 and #close == 0 then
        lines[#lines + 1] = "Совпадений нет — собери больше улик"
    end
    return lines
end

-- ═══ СКАНЕР ЖУРНАЛА ═══
local function scanGui(root)
    local texts = {}
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("TextLabel") or d:IsA("TextBox") then
            local tx = d.Text
            if tx and #tx > 0 and #tx < 400 then
                texts[#texts + 1] = tx
            end
        end
    end
    return texts
end

local function scanPills()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end
    local texts = scanGui(pg)
    local ev, cf = {}, {}
    local solver = {}
    for _, tx in ipairs(texts) do
        local low = tx:lower()
        -- улики: строгое совпадение текста пилюли ("EMF Level 5",
        -- "Handprints", "[Ghost Orb]" и т.п.)
        if #tx <= 40 then
            local key = EV_LOOKUP[normTxt(tx)]
            if key then
                ev[key] = true
                if low:find("confirm") then cf[key] = true end
            end
        end
        -- подтверждение в той же строке: "[EMF] confirmed"
        if low:find("confirm") then
            for _, e in ipairs(EVIDENCE_DEFS) do
                for _, p in ipairs(e.pats) do
                    if tx:upper():find(p, 1, true) then
                        ev[e.key] = true
                        cf[e.key] = true
                    end
                end
            end
        end
        -- солвер: копируем вывод журнала целиком
        if tx:find("^Confirmed: ") or tx:find("^Possible: ")
            or tx:find("^Close %(1 evidence may be fake%): ")
            or tx:find("^No ghost matches") then
            solver[#solver + 1] = tx
        end
        -- spirit box: возраст/пол/комнаты/температура
        local sb = tx:match("^%s*%[?SPIRIT BOX%]?%s*[:%-]%s*(.+)$")
        local src = sb or tx
        local age = src:match("[Aa]ge%s*[:%-]%s*(%d+)")
        if age then DATA.age = age end
        local gen = src:match("[Gg]ender%s*[:%-]%s*([%w%s]+)")
        if gen then DATA.gender = gen:match("^%s*(.-)%s*$") end
        local room = src:match("Current Room%s*[:%-]%s*([^,]+)")
        if room then DATA.room = room:match("^%s*(.-)%s*$") end
        local fav = src:match("Favorite Room%s*[:%-]%s*(.+)")
        if fav then DATA.favRoom = fav:match("^%s*(.-)%s*$") end
        local temp = src:match("Temperature%s*[:%-]%s*(-?%d+%.?%d*)")
        if temp then DATA.temperature = tonumber(temp) end
        local diff = src:match("Difficulty%s*[:%-]%s*(.+)")
        if diff then DATA.difficulty = diff:match("^%s*(.-)%s*$") end
        if low:find("hunting") then DATA.hunting = "Hunting" end
    end
    DATA.evidence = ev
    DATA.confirmed = cf
    DATA.solverLines = solver
    DATA.lastUpdate = os.clock()
end

-- ═══ СКАНЕР МИРА (реальные объекты игры, как в Demonology Pro) ═══
-- Раз в секунду один прогон workspace:GetDescendants():
-- улики, температура комнат, стамина-инфо, призрак, охота.
local worldScan = {
    prints = false, orb = nil, insc = nil, emf = 0,
    writing = false, wither = false, laserPlaced = false,
    minTemp = nil, minTempRoom = "?",
    sbAnswer = "", hunting = "?", itemsCount = 0,
}
local function scanWorld()
    local okW, errW = pcall(function()
        worldScan.prints = false
        worldScan.orb = nil
        worldScan.insc = nil
        worldScan.emf = 0
        worldScan.writing = false
        worldScan.wither = false
        worldScan.laserPlaced = false
        worldScan.itemsCount = 0
        -- температура комнат (атрибут Temperature у workspace.Map.Rooms/*)
        local minTemp, minRoom = nil, "?"
        local m = workspace:FindFirstChild("Map")
        local rooms = m and m:FindFirstChild("Rooms")
        if rooms then
            for _, room in ipairs(rooms:GetChildren()) do
                local t = room:GetAttribute("Temperature")
                if t ~= nil and (minTemp == nil or t < minTemp) then
                    minTemp, minRoom = t, room.Name
                end
            end
        end
        worldScan.minTemp = minTemp
        worldScan.minTempRoom = minRoom
        -- папка Handprints + глобальный прогон
        local handFolder = workspace:FindFirstChild("Handprints")
        if handFolder and #handFolder:GetChildren() > 0 then
            worldScan.prints = true
        end
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("BasePart") then
                local n = d.Name
                if n == "Handprint1" or n == "Handprint2"
                    or n == "Footprint" or n == "Footprint1" then
                    worldScan.prints = true
                elseif n == "GhostOrb" and worldScan.orb == nil then
                    worldScan.orb = d
                elseif n:lower():find("inscription") and worldScan.insc == nil then
                    worldScan.insc = d
                end
            elseif d:IsA("Folder") and d.Name == "Indicators" then
                for _, v in ipairs(d:GetChildren()) do
                    if v:IsA("BasePart") and v.Material == Enum.Material.Neon
                        and tonumber(v.Name) and tonumber(v.Name) > worldScan.emf then
                        worldScan.emf = tonumber(v.Name)
                    end
                end
            elseif d:IsA("Decal") then
                local m2 = d:FindFirstAncestorWhichIsA("Model")
                if m2 and m2:GetAttribute("ItemName") == "Spirit Book"
                    and d.Texture ~= nil and d.Texture ~= "" then
                    worldScan.writing = true
                end
            elseif d:IsA("BasePart") and d.Name == "Petals" then
                local c = d.Color
                if c and c.R == 0 and c.G == 0 and c.B == 0 then
                    worldScan.wither = true
                end
            end
        end
        -- предметы: сколько всего + лазерный проектор
        local items = workspace:FindFirstChild("Items")
        if items then
            for _, it in ipairs(items:GetChildren()) do
                worldScan.itemsCount = worldScan.itemsCount + 1
                local dn = it:GetAttribute("DisplayName") or it.Name
                if dn == "Laser Projector" then worldScan.laserPlaced = true end
                if it.Name == "Petals" then
                    for _, pp in ipairs(it:GetDescendants()) do
                        if pp:IsA("BasePart") and pp.Name == "Petals" then
                            local c = pp.Color
                            if c and c.R == 0 and c.G == 0 and c.B == 0 then
                                worldScan.wither = true
                            end
                        end
                    end
                end
            end
        end
        -- Spirit Box: субтитры с ответом призрака
        pcall(function()
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            local sub = pg and pg:FindFirstChild("Subtitles")
            local holder = sub and sub:FindFirstChild("Holder")
            local tl = holder and holder:FindFirstChildWhichIsA("TextLabel")
            worldScan.sbAnswer = (tl and tl.Text or "")
        end)
        -- призрак: охота?
        local g = workspace:FindFirstChild("Ghost")
        worldScan.hunting = (g and g:GetAttribute("Hunting") == true) and "ОХОТА!" or (g and "спокоен" or "?")
    end)
    if not okW then warn("[DHL] worldScan error: " .. tostring(errW)) end
end

-- перенос найденных улик в DATA (только добавление — улики не исчезают)
local function applyWorldEvidence()
    if not CFG.EvidenceWatch then return end
    local E = DATA.evidence
    local added = false
    local function add(k)
        if not E[k] then E[k] = true added = true end
    end
    if worldScan.prints then add("Prints") end
    if worldScan.orb then add("Orb") end
    if worldScan.insc or worldScan.writing then add("Inscription") end
    if worldScan.emf >= 5 then add("EMF") end
    if worldScan.wither then add("Wither") end
    if worldScan.minTemp ~= nil and worldScan.minTemp <= 0 then add("Freezing") end
    if #worldScan.sbAnswer:gsub("%s+", "") >= 3 then add("SB") end
    if added then
        DATA.lastUpdate = os.clock()
        DATA.solverLines = solverLines()
    end
end

-- ═══ ОТЧЁТ «ПРОВЕРИТЬ УЛИКИ» (улики + журнал + решение + статус) ═══
local function buildReport()
    scanPills() -- форс-скан прямо по нажатию
    scanWorld()
    applyWorldEvidence()
    local L = {}
    L[#L + 1] = "── УЛИКИ ──"
    local found = 0
    for _, e in ipairs(EVIDENCE_DEFS) do
        if DATA.evidence[e.key] then
            found = found + 1
            L[#L + 1] = (DATA.confirmed[e.key] and "✔ " or "• ") .. e.label
        end
    end
    if found == 0 then L[#L + 1] = "пока ничего — открой журнал в игре" end

    L[#L + 1] = ""
    L[#L + 1] = "── ЗАПИСЬ ЖУРНАЛА ──"
    if #DATA.solverLines > 0 then
        for _, s in ipairs(DATA.solverLines) do L[#L + 1] = s end
    else
        L[#L + 1] = "журнал не дал строк солвера"
    end

    L[#L + 1] = ""
    L[#L + 1] = "── РЕШЕНИЕ ──"
    for _, s in ipairs(solverLines()) do L[#L + 1] = s end

    L[#L + 1] = ""
    local t = DATA.temperature
    L[#L + 1] = "Статус: " .. DATA.hunting .. " • Возраст: " .. DATA.age
        .. " • T: " .. (t and string.format("%.1f", t) or "n/a")
    return table.concat(L, "\n")
end

