-- ═══ WIND UI LOADER (2 зеркала × 2 CDN × 3 попытки) ═══
-- ВАЖНО: внутри Wind UI иконки грузятся с GitHub без pcall — любой
-- сбой сети убивает всю либу, поэтому зеркал несколько и есть
-- резервный GUI ниже.
-- httpGet: 4 транспорта подряд — на ПК-инжекторах часто есть только
-- один из них (HttpGet / HttpGetAsync / request / HttpService)
local function httpGet(url)
    local ok, res
    if type(game.HttpGet) == "function" then
        ok, res = pcall(game.HttpGet, game, url)
        if ok and type(res) == "string" and #res > 0 then return res end
    end
    if type(game.HttpGetAsync) == "function" then
        ok, res = pcall(game.HttpGetAsync, game, url)
        if ok and type(res) == "string" and #res > 0 then return res end
    end
    local rq = (type(http_request) == "function" and http_request)
        or (type(request) == "function" and request)
        or (syn and type(syn.request) == "function" and syn.request)
    if rq then
        ok, res = pcall(rq, { Url = url, Method = "GET" })
        if ok and type(res) == "table" and type(res.Body) == "string" and #res.Body > 0 then
            return res.Body
        end
    end
    ok, res = pcall(function()
        return game:GetService("HttpService"):GetAsync(url)
    end)
    if ok and type(res) == "string" and #res > 0 then return res end
    error("HTTP недоступен в этом исполнителе")
end

